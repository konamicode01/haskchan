cabal-version: 1.12

name:           phi
version:        0.1.0.0
description:    Pedagogical Haskell Imageboard
--homepage:       
--bug-reports:    
--author:         
--license:        
--license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: http://phisourcepwswfgptrbut2puqant75jyu55t4vgjako7bbhk3wyqmqid.onion/phichannel/phi.git/

library
  exposed-modules:
      Phi
    , Phi.Auth
    , Phi.Auth.Crypto
    , Phi.Captcha
    , Phi.Context
    , Phi.Database
    , Phi.Database.Models
    , Phi.Database.Queries
    , Phi.Database.Queries.Now
    , Phi.Database.Queries.Types
    , Phi.Files
    , Phi.Files.Filetypes
    , Phi.Files.Thumbnails
    , Phi.Forms
    , Phi.HTTP
    , Phi.Layout.Base
    , Phi.Layout.Attributes
    , Phi.Layout.Components.Board
    , Phi.Layout.Components.Mod
    , Phi.Layout.Components.Post
    , Phi.Layout.Pages.Auth
    , Phi.Layout.Pages.Catalogue
    , Phi.Layout.Pages.Error
    , Phi.Layout.Pages.Homepage
    , Phi.Layout.Pages.Index
    , Phi.Layout.Pages.Log
    , Phi.Layout.Pages.Mod
    , Phi.Layout.Pages.Recent
    , Phi.Layout.Pages.Thread
    , Phi.Layout.Pages.Forms.Banners
    , Phi.Layout.Pages.Forms.MakeBoard
    , Phi.Layout.Pages.Forms.BoardSettings
    , Phi.Layout.Pages.Forms.GlobalSettings
    , Phi.Layout.Pages.Forms.Login
    , Phi.Layout.Pages.Forms.Register
    , Phi.Routes
    , Phi.Routes.Meta
    , Phi.Routes.Meta.Varstatic
    , Phi.Routes.Auth
    , Phi.Routes.Errors
  hs-source-dirs:
      src
  build-depends:
      base >=4.7 && <5
    , base64
    , binary
    , blaze-builder
    , bytestring
    , cookie
    , cryptonite
    , cryptonite-conduit
    , data-default
    , directory
    , direct-sqlite
    , ffmpeg-light
    , fn
    , FontyFruity
    , http-types
    , JuicyPixels
    , lucid
    , memory
    , password
    , random
    , Rasterific
    , regex
    , regex-with-pcre
    , resource-pool
    , safe-exceptions
    , sqlite-simple
    , text
    , time
    , wai
    , wai-extra
    , warp
  default-language: Haskell2010

executable phi-exe
  main-is: Main.hs
  hs-source-dirs:
      app
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , phi
    , warp
  default-language: Haskell2010

test-suite phi-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Common
      AuthSpec
      CaptchaSpec
      FileSpec
      FormSpec
      QuerySpec
      WebSpec
  hs-source-dirs:
      test
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , phi
    , base64
    , bytestring
    , hspec
    , hspec-fn
    , lucid
    , password
    , text
  default-language: Haskell2010
